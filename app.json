{
  "expo": {
    "name": "muslimconnect",
    "slug": "muslimconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/quran.png",
    "scheme": "muslimconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/quran.png",
        "backgroundColor": "#040C23"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/quran.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#040C23"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
